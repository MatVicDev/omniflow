# ─── OmniFlow API ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./omniflow.db
CORS_ORIGINS=["http://localhost:5173"]

# ─── Motor de IA ─────────────────────────────────────────────────
# auto     → usa Anthropic se houver chave, senão OpenAI, senão offline
# offline  → NLU + busca semântica locais (demo sem custo e sem internet)
# anthropic | openai → força um provedor
AI_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────
WHATSAPP_VERIFY_TOKEN=omniflow-verify
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
